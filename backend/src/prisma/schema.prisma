// This is your Prisma schema file,
generator client {
  provider      = "prisma-client-js"
  output        = "../generated/prisma"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Auth models

model User {
  id         String         @id @default(uuid())
  email      String         @unique
  name       String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  identities UserIdentity[]
  leads      Lead[]
  companies  Company[]
  isDeleted  Boolean        @default(false)
  role       String         @default("Sales Representative")
  tasks      Task[]
  deals      Deal[]
  tickets    Ticket[]
  products   Product[]
  quotes     Quote[]
  invoices   Invoice[]
  activities Activity[]
  notifications Notification[]
  auditLogs  AuditLog[]
  automationRules AutomationRule[]

  @@index([email])
}

// ... UserIdentity and ContactMessage ...

model Lead {
  id              String   @id @default(uuid())
  name            String
  email           String?
  role            String?
  company         String?
  industry        String?
  status          String   @default("New Lead")
  accountId       String?
  accountName     String?
  website         String?
  subIndustry     String?
  description     String?
  source          String?
  phone           String?
  priority        String   @default("Medium")
  score           Int      @default(0)
  notes           String?
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  isDeleted       Boolean  @default(false)
  deals           Deal[]

  @@index([userId])
  @@index([email])
  @@index([accountId])
}

model Deal {
  id              String   @id @default(uuid())
  name            String
  stage           String   @default("New Lead")
  value           Float    @default(0)
  probability     Int      @default(10)
  expectedCloseDate String?
  lostReason      String?
  leadId          String?
  lead            Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  isDeleted       Boolean  @default(false)
  @@index([userId, stage])
}

model Task {
  id              String   @id @default(uuid())
  title           String
  description     String?
  dueDate         String?
  priority        String   @default("Medium")
  status          String   @default("Open")
  type            String   @default("Task")
  customerName    String?
  assignedTo      String?
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  isDeleted       Boolean  @default(false)
  @@index([userId, status])
  @@index([dueDate])
}

model Ticket {
  id              String   @id @default(uuid())
  subject         String
  description     String?
  category        String?
  priority        String   @default("Medium")
  status          String   @default("Open")
  customerName    String?
  satisfaction    Int?
  resolution      String?
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  isDeleted       Boolean  @default(false)
  @@index([userId, status])
}

model Product {
  id              String   @id @default(uuid())
  name            String
  category        String?
  description     String?
  price           Float    @default(0)
  active          Boolean  @default(true)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  isDeleted       Boolean  @default(false)
  @@index([userId, active])
}

model Quote {
  id              String   @id @default(uuid())
  number          String
  customerName    String
  amount          Float    @default(0)
  tax             Float    @default(0)
  discount        Float    @default(0)
  status          String   @default("Draft")
  validUntil      String?
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  isDeleted       Boolean  @default(false)
  @@unique([userId, number])
}

model Invoice {
  id              String   @id @default(uuid())
  number          String
  customerName    String
  amount          Float    @default(0)
  dueDate         String?
  status          String   @default("Pending")
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  isDeleted       Boolean  @default(false)
  @@unique([userId, number])
}

model Activity {
  id              String   @id @default(uuid())
  type            String
  description     String
  entityType      String?
  entityId        String?
  occurredAt      DateTime @default(now())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, occurredAt])
}

model Notification {
  id              String   @id @default(uuid())
  title           String
  message         String
  type            String   @default("info")
  read            Boolean  @default(false)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  @@index([userId, read])
}

model AuditLog {
  id              String   @id @default(uuid())
  action          String
  entityType      String
  entityId        String?
  before          Json?
  after           Json?
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  @@index([userId, entityType, createdAt])
}

model AutomationRule {
  id          String   @id @default(uuid())
  name        String
  trigger     String
  action      String
  owner       String
  frequency   String   @default("Instant")
  active      Boolean  @default(true)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isDeleted   Boolean  @default(false)

  @@index([userId, active])
}

model Company {
  id              Int      @id @default(autoincrement())
  accountId       String?
  name            String
  website         String?
  industry        String?
  subIndustry     String?
  description     String?
  enrichedData    Json?
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  isDeleted       Boolean  @default(false)

  @@index([userId])
  @@index([accountId])
}



model UserIdentity {

  id         String   @id @default(uuid())

  userId     String

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider   String // 'Google', 'GitHub', 'EmailPassword', 'PhoneOTP', etc.

  providerId String // Provider's unique user ID (or email for email/password)

  metadata   Json? // Provider-specific data (passwordHash, tokens, profile data, etc.)

  createdAt  DateTime @default(now())

  updatedAt  DateTime @updatedAt

  isDeleted  Boolean  @default(false)



  @@unique([provider, providerId])

  @@index([userId])

}



model ContactMessage {

  id        Int      @id @default(autoincrement())

  name      String

  email     String

  message   String

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  isDeleted Boolean  @default(false)



  @@index([email])

}



model Otp {

  id         String   @id @default(uuid())

  identifier String   // Phone number or email address

  type       String   // 'phone' or 'email'

  otp        String   // Hashed OTP

  expiresAt  DateTime

  attempts   Int      @default(0)

  verified   Boolean  @default(false)

  purpose    String?  // 'login', 'registration', 'password_reset', '2fa', etc.

  createdAt  DateTime @default(now())

  updatedAt  DateTime @updatedAt

  isDeleted  Boolean  @default(false)



  @@index([identifier, type])

  @@index([expiresAt])

  @@index([identifier, type, verified])

}
